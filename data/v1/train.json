  "train_config": {
    "batch_size": 16,
    "accumulation_steps": 2,
    "epochs": 20,
    "lr": 0.0007,
    "min_lr": 0.0001,
    "warmup_ratio": 0.03,
    "patience": 4,
    "precision": "fp32"
  }
